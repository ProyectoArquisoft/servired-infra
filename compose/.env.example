# Copia este archivo como compose/.env y completa los valores. Nunca subas el .env a git.
# Usa contraseñas sin caracteres especiales (@ : / ? #), porque van dentro de URLs.

# --- Imágenes (opcional) ---
# IMAGE_PREFIX=ghcr.io/proyectoarquisoft/servired-
# TAG=latest

# --- RabbitMQ (solo red interna; consola en http://localhost:15672) ---
RABBITMQ_USER=servired
RABBITMQ_PASSWORD=cambia-esto

# --- Supabase Auth (Project Settings -> API / JWT) ---
# Usa UNA de las dos: JWKS (llaves asimétricas) o secreto HS256 (proyectos con secreto heredado).
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_JWKS_URL=https://<proyecto>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
# Solo la usa Reportes (Storage). Es secreta: nunca en la app ni en git.
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=evidencias

# --- Base de datos (rol de cada servicio; mismas contraseñas que pasaste a supabase/00_roles_and_schemas.sql) ---
# Usa el session pooler de Supabase (Connect -> Session pooler, puerto 5432): el host directo puede ser solo IPv6.
# En el pooler el usuario lleva el ref del proyecto: svc_reportes.<ref>
REPORTES_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
REPORTES_DB_USER=svc_reportes.<ref>
REPORTES_DB_PASSWORD=

MODERACION_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
MODERACION_DB_USER=svc_moderacion.<ref>
MODERACION_DB_PASSWORD=

INDICADORES_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
INDICADORES_DB_USER=svc_indicadores.<ref>
INDICADORES_DB_PASSWORD=

# Con el perfil local-db en vez de Supabase:
#   *_DB_URL=jdbc:postgresql://db:5432/postgres   y   *_DB_USER=svc_reportes / svc_moderacion / svc_indicadores
# LOCAL_DB_ADMIN_PASSWORD=postgres

# --- Reglas del gateway / moderación (opcionales) ---
# RATE_LIMIT_FRAUDES_POR_MINUTO=5
# true solo con el perfil tunnel
# GATEWAY_CONFIAR_CF_IP=false
# SYNC_TIMEOUT_MS=2000
