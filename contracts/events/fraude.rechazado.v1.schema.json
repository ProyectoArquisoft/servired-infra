{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ProyectoArquisoft/servired-infra/contracts/events/fraude.rechazado.v1.schema.json",
  "title": "Evento fraude.rechazado v1",
  "description": "Publicado por Moderación al rechazar un reporte de fraude. NO contiene ningún dato de usuario. Lo consume Indicadores.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "fraude.rechazado"
        },
        "version": {
          "const": 1
        },
        "source": {
          "const": "moderacion"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idFraude",
            "idServicio",
            "fecha"
          ],
          "properties": {
            "idFraude": {
              "type": "integer",
              "minimum": 1
            },
            "idServicio": {
              "type": "integer",
              "minimum": 1
            },
            "fecha": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  ]
}
