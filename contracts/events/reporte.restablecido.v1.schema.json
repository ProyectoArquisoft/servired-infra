{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ProyectoArquisoft/servired-infra/contracts/events/reporte.restablecido.v1.schema.json",
  "title": "Evento reporte.restablecido v1",
  "description": "Publicado por Reportes cuando el restablecimiento queda confirmado (estado RESTABLECIDO). Lo consume Indicadores.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "reporte.restablecido"
        },
        "version": {
          "const": 1
        },
        "source": {
          "const": "reportes"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idReporte",
            "idServicio",
            "departamento",
            "municipio",
            "fechaCreacion",
            "fechaResolucion",
            "duracionInterrupcionHoras"
          ],
          "properties": {
            "idReporte": {
              "type": "integer",
              "minimum": 1
            },
            "idServicio": {
              "type": "integer",
              "minimum": 1
            },
            "departamento": {
              "type": [
                "string",
                "null"
              ]
            },
            "municipio": {
              "type": [
                "string",
                "null"
              ]
            },
            "fechaCreacion": {
              "type": "string",
              "format": "date-time"
            },
            "fechaResolucion": {
              "type": "string",
              "format": "date-time"
            },
            "duracionInterrupcionHoras": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  ]
}
